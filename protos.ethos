Schema.{0 1 0}
[]

;; Protos is the universal structural substrate.  A dialect supplies the
;; Portion <-> embodied-type anatomy; Protos alone reads and writes characters.

Types.[
  Text.{Normalized.String ContentHash.ContentHash}
  ContentHash.UnsignedInteger
  Symbol.String
  Extent.{Start.ByteOffset End.ByteOffset}
  Separator.[Period Exclamation Colon]
  BareExpectation.[Symbol String]
  Enclosure.[Braced Bracketed Guillemets Angled CurlyQuote]
  StructuralEnclosure.[Braced Bracketed Guillemets Angled]
  DialectBoundary.[Parentheses]
  OpaqueBoundary.[CurlyQuote Dialect.DialectBoundary]
  Boundary.[Structural.StructuralEnclosure Opaque.OpaqueBoundary]
  Portion.[
    Headed.{Extent.Extent Content.Headed}
    Enclosed.{Extent.Extent Content.Enclosed}
    Bare.{Extent.Extent Content.Bare}
    FromSignedI64.[Portion]
    FromDecimalF64.[Result<Portion Fault>]
    FromExpectedString.[Result<Portion Fault>]
  ]
  Headed.{Head.Symbol Separator.Separator Body.Portion}
  Enclosed.[Structural.StructuralEnclosed Opaque.OpaqueEnclosed]
  StructuralEnclosed.{Enclosure.StructuralEnclosure Portions.[Portion]}
  OpaqueEnclosed.{Boundary.OpaqueBoundary Content.String}
  Bare.{Symbol.Symbol}
  Delineation.{Root.Portions}
  Fault.{Extent.Extent Problem.FaultProblem}
  FaultProblem.[UnexpectedCloser UnclosedDelimiter MissingHead MissingBody ExpectedOnePortion ExpectedShape ExpectedBareSymbol InvalidSignedInteger IntegerOutOfRange InvalidDecimal NonFiniteDecimal]
  Layout.[Flat]
  Prospective.{Text.Text<T>}
]

Kinds.[
  Delineatable.{delineate.[Result<Delineation Fault>]}
  Embodiable.{embody.[Result<Self.Embodied Fault>]}
  Embodied.{Sized fromPortion.[Result<Self Fault>]}
  Textualizable.{Embodied toPortion.[Portion] textualize.[Text]}
  ShapeDefined.{matches.[Boolean]}
  ContentHashable.{contentHash.[ContentHash]}
  BareSafe.{isBareSafeFor.{[BareExpectation] [Boolean]}}
  PortionText.{canonicalText.[Text]}
  EnclosedArity.{arity.[Natural]}
  EnclosedAnatomy.{structuralEnclosure.[Optional<StructuralEnclosure>] opaqueBoundary.[Optional<OpaqueBoundary>] portions.[Optional<[Portion]>] opaqueContent.[Optional<String>]}
  Printing.{print.[Text]}
  ScalarAnatomy.{signedI64.[Result<Signed64 Fault>] decimalF64.[Result<Float64 Fault>]}
  DelineatedText.{delineation.[Optional<Delineation>] retag.[Text<T>]}
]

Associations.[
  Text.[Delineatable Embodiable ContentHashable BareSafe DelineatedText]
  Prospective.[Delineatable Embodiable]
  Delineation.[Printing]
  Portion.[Printing PortionText ScalarAnatomy]
]

;; Structural enclosures own Portion children. Curly quotes and dialect
;; parentheses own opaque content. Parentheses are balanced through the sole
;; delimiter machinery; `\\`, `\(`, and `\)` encode a literal backslash,
;; unmatched opening parenthesis, and unmatched closing parenthesis. Curly
;; quotes balance asymmetrically without escapes.
;; Comments and whitespace are non-structural trivia, dropped by canonical
;; delineation then printing. Parentheses are intentionally not an Enclosure.
;; A Symbol expects one Bare Portion. A String expects exactly one Portion and
;; recovers its canonical text through PortionText; multiple root siblings are
;; not bare-safe for either expectation.
;; ScalarAnatomy answers signed 64-bit integers from one Bare Portion and
;; finite decimals from Period-headed Portion anatomy. Scalar spelling is
;; canonical: no plus, leading zero, integer negative zero, or exponent; a
;; decimal always has its point. DelineatedText.retag changes Text's target
;; type while preserving printer-computed canonical text and delineation.
;; Portion duplication is pure anatomy duplication: it retains validated inbound
;; extents, while every writer projection computes fresh outbound extents.
;; Portion construction owns signed integer/decimal formatting and String's
;; unquoted-one-Portion or validated balanced-curly opaque choice.
;;
;; Public Rust declaration ownership for E2 comparison:
;; `Text<T = ()>` and `Prospective<T = ()>` own their target generic, while
;; Text's cached delineation and PhantomData are engine-private.  `Delineatable`
;; declares associated `Delineation`; `Embodiable` declares associated `Embodied:
;; Embodied`; the receiver and Result signatures above are public. `Embodied:
;; Sized`; `Textualizable: Embodied`; and `DelineatedText::retag<U>` is generic.
;; These generic/associated-type heads are part of the map-owned public surface
;; even where the structural body records only their capability anatomy. Parser,
;; printer, hashing, delimiter, extent, and cached-state implementation bodies
;; are explicitly engine-owned and excluded from source equality.
